# Obsidian vault path
VAULT_HOST_PATH=/path/to/your/obsidian/vault
VAULT_PATH=/path/to/vault1,/path/to/vault2

# APP variables
APP_USER=admin
APP_PASSWORD=change-me
SESSION_SECRET=change-this-secret

# External port
PORT=9090

# Hermes API Backend (dashboard mode on port 9119)
HERMES_API_URL=http://localhost:9119
HERMES_API_KEY=""

# Speaches API (TTS + STT) - VPS
SPEACHES_API_URL=http://your-vps-domain.com:8000
SPEACHES_API_KEY=your-api-key-here

# Legacy Kokoro TTS (deprecated)
KOKORO_API_URL=https://your-vps-domain.com/audio/speech
KOKORO_AUTO_PLAY=true

# Legacy Whisper STT (local whisper.cpp) - deprecated
WHISPER_CPP_PATH=/path/to/whisper/main.exe
WHISPER_MODEL_PATH=/path/to/ggml-base.bin

# Audio file management
AUDIO_MAX_ENTRIES=10
AUDIO_TEMP_DIR=/tmp