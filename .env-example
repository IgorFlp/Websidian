# Obsidian vault path
VAULT_HOST_PATH=/path/to/your/obsidian/vault
VAULT_PATH=/path/to/vault1,/path/to/vault2

# APP variables
APP_USER=admin
APP_PASSWORD=change-me
SESSION_SECRET=change-this-secret

# External port
PORT=9090

# Hermes API Backend (dashboard mode on port 9119)
HERMES_API_URL=http://localhost:9119
HERMES_API_KEY=""

# Speaches API (TTS + STT) - VPS
SPEACHES_API_URL=http://your-vps-domain.com:8000
SPEACHES_API_KEY=your-api-key-here

# TTS Configuration
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=pm_alex
TTS_LANGUAGE=pt

# STT Configuration
STT_MODEL=dwhoelz/whisper-medium-pt-ct2
STT_LANGUAGE=pt


# Audio file management
AUDIO_MAX_ENTRIES=10
AUDIO_TEMP_DIR=/tmp