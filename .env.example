# Websidian Configuration

# Required: Path to your Obsidian vault(s), comma-separated for multiple vaults
VAULT_PATH=/vault

# Required: Session secret for authentication
SESSION_SECRET=your-session-secret-here

# Required: Application username and password for web login
APP_USER=admin
APP_PASSWORD=your-password-here

# Hermes AI Gateway (optional)
HERMES_API_URL=http://localhost:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# Speech-to-Text (Speaches) (optional)
SPEACHES_API_URL=http://localhost:8000
SPEACHES_API_KEY=

# Text-to-Speech (Kokoro) (optional)
KOKORO_API_URL=
KOKORO_AUTO_PLAY=true

# Audio Settings
STT_MODEL=adminbr/whisper-small-pt-ct2
STT_LANGUAGE=pt
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=pm_alex
TTS_LANGUAGE=pt
TTS_SPEED=1.0
AUDIO_MAX_ENTRIES=10

# Data and Public Directories
DATA_DIR=/data
PUBLIC_DIR=/public
PRESETS_FILE=/data/presets.json

# Server Port
PORT=9091

# MCP (Model Context Protocol) Server
# Set this to enable API_KEY authentication for MCP tools
# When set, MCP tools will require Authorization: Bearer <MCP_API_KEY> header
MCP_API_KEY=

BESZEL_API_KEY=